{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://ai-film-production/schemas/geography.schema.json",
  "title": "Geography (world design · objective spatial facts)",
  "description": "04-world/<SCENE>/geography.json：世界设计的空间方位事实，风格中立。是空间/方位的唯一客观源，场景卡只引用不重写。space.structure 以封闭标签锁定建筑形制，场景卡的 interior_exterior/architecture 只能取与之相容的措辞——『附屋→敞棚』类漂移由 G05/W 闸 FAIL。",
  "type": "object",
  "required": ["scene_id", "version", "frozen", "spaces", "world_convention"],
  "properties": {
    "scene_id": { "type": "string", "description": "世界场景标识（world_id），与目录名对应" },
    "version": { "type": "string" },
    "frozen": { "type": "boolean", "description": "过 gate W 后翻 true；冻结后改动走 ECN" },
    "world_convention": {
      "type": "object",
      "description": "罗盘与方位约定（全场景统一）",
      "required": ["compass"],
      "properties": {
        "compass": {
          "type": "object",
          "required": ["north"],
          "properties": {
            "north": { "type": "string", "enum": ["N", "E", "S", "W"] }
          }
        },
        "left_right_rule": { "type": "string", "description": "左右映射由 build_axis.py 计算，禁心算" }
      }
    },
    "spaces": {
      "type": "array",
      "minItems": 1,
      "description": "逐个空间（含其建筑形制锁定块）",
      "items": {
        "type": "object",
        "required": ["id", "name", "structure"],
        "properties": {
          "id": { "type": "string", "description": "空间稳定标识 space_id，如 BINSHELTER/STUDY" },
          "name": { "type": "string" },
          "structure": {
            "type": "object",
            "description": "建筑形制锁定字段：场景卡措辞须与此相容",
            "required": ["type", "enclosure", "roof", "walls"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["attached-room", "main-hall", "open-shed", "tower", "boat", "courtyard", "gatehouse", "corridor"],
                "description": "附屋/正厅/敞棚/楼阁/舟船/院落/门屋/廊道"
              },
              "enclosure": {
                "type": "string",
                "enum": ["enclosed", "semi-open", "open"]
              },
              "roof": {
                "type": "string",
                "enum": ["tile", "thatch", "wood", "mat", "none"]
              },
              "walls": {
                "type": "string",
                "enum": ["brick", "rammed-earth", "wood", "stone"]
              },
              "openings": {
                "type": "array",
                "description": "门窗及其朝向",
                "items": {
                  "type": "object",
                  "required": ["id", "face"],
                  "properties": {
                    "id": { "type": "string" },
                    "face": { "type": "string", "enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"] }
                  }
                }
              }
            }
          },
          "connects_to": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "objects": {
      "type": "array",
      "description": "关键物件的世界方位",
      "items": {
        "type": "object",
        "required": ["id", "space"],
        "properties": {
          "id": { "type": "string" },
          "space": { "type": "string", "description": "所在 space_id" },
          "position": { "type": "string" }
        }
      }
    },
    "light_sources": {
      "type": "array",
      "description": "practical 光源及其客观计数",
      "items": {
        "type": "object",
        "required": ["id", "space", "count"],
        "properties": {
          "id": { "type": "string" },
          "space": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "exits_entrances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "space"],
        "properties": {
          "id": { "type": "string" },
          "space": { "type": "string" }
        }
      }
    }
  }
}
